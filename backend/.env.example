# JWT Güvenlik Ayarları
JWT_SECRET_KEY=pod-multi-tenant-super-secret-jwt-key-2026-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Sunucu ve Müşteri Geçici Takip Linki Baz URL'leri
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_TRACKING_WEB_URL=http://localhost:8000/api/v1/tracking/public

# Supabase / PostgreSQL Bağlantısı (Boş bırakılırsa backend/data/local_db.json otomatik devreye girer)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pod-media

# Otomatik Excel PoD Arşiv E-posta (SMTP) Ayarları
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=arsiv@isletmeniz.com
SMTP_PASSWORD=uygulama-sifresi-buraya
SMTP_FROM=noreply@isletmeniz.com
SMTP_USE_TLS=true
